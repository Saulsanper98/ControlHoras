# Base de datos (coincide con docker-compose.yml). POSTGRES_PASSWORD la usa
# docker-compose.yml para levantar el contenedor de Postgres; debe coincidir
# con la contraseña usada en DATABASE_URL. Cambia el valor de ejemplo en
# cualquier despliegue real.
POSTGRES_PASSWORD="portal_dev_password"
# Puerto host 5433 (mapeado en docker-compose). NO uses 5432 si ya tienes
# otro Postgres en Windows: dará Authentication failed.
DATABASE_URL="postgresql://portal:portal_dev_password@localhost:5433/portal_empleado?schema=public"

# Auth.js — copia este fichero a `.env` y genera un secreto real:
#   cp .env.example .env && npx auth secret
AUTH_SECRET="genera-uno-con: npx auth secret"

# Acceso por IP LAN (obligatorio). apply-lan-env.mjs fija AUTH_URL a
# http://<tu-ip>:3000. No uses localhost en el navegador.
AUTH_TRUST_HOST=true
# AUTH_URL lo escribe: node scripts/apply-lan-env.mjs 192.168.12.45

# Carpeta donde se guardan los ficheros subidos (firmas, adjuntos, horarios, noticias)
UPLOADS_DIR="./uploads"
